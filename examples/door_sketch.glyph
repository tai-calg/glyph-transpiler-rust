system Door
  entry control

  in sensor:In
  in panel:In
  out result:B

  sensor -> control
  panel -> control
  control -> result
  control -> lock
  control -> log

@MAX=1000

*In(open,auth,stop:B,value:U)
+C=Stop|Run(U)
+Error=Bad

ext sensor():In
ext panel():In

>merge(sensor_input:In,panel_input:In):In=In(panel_input.open,panel_input.auth,sensor_input.stop,max(sensor_input.value,panel_input.value))
>validate(input:In):In|Error=Ok(input)
>command(value:U):C|Error=Ok(Run(value))

>ctl(input:In):C|Error=
  input
  /> validate?
  /> |checked| checked.value
  /> |value| min(value,MAX)
  /> command

!lock(command:C):B
!log(command:C):B

>apply(command:C):B
  command==Stop >> lock(command)
  _ >> log(command)

>control():B|Error=Ok(apply(ctl(merge(sensor(),panel()))?))

?safe(*In)=@A(!auth>>!open)
