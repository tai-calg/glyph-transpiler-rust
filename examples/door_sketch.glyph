system Door=control

@MAX=1000

*In(open,auth,stop:B,value:U)
+C=Stop|Run(U)
+Error=Bad

ext sensor():In
ext panel():In

>merge(sensor_input:In,panel_input:In):In=In(panel_input.open,panel_input.auth,sensor_input.stop,max(sensor_input.value,panel_input.value))
>validate(i:In):In|Error=Ok(i)
>command(n:U):C|Error=Ok(Run(n))

>ctl(i:In):C|Error=
  i
  /> validate?
  /> |x| x.value
  /> |n| min(n,MAX)
  /> command

!lock(c:C):B=true
!log(c:C):B=true

>apply(c:C):B
  c==Stop >> lock(c)
  _ >> log(c)

>control():B|Error=apply(ctl(merge(sensor(),panel()))?)

?safe(*In)=@A(!auth >> !open)
