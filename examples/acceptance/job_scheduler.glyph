system BatchRuntime
  entry run

  in input:BatchInput
  out receipt:SubmitReceipt

  input -> run
  run -> receipt
  run -> layout_lane
  run -> submit_batch

*Packet(count:U)
*Lanes(free:U)
*BatchInput(packet:Packet,lanes:Lanes,size:U)
*BatchLayout(lane,size:U)
*SubmitReceipt(lane:U)
+Error=EmptyPacket|NoLane

>validate(input:BatchInput):BatchInput|Error
  input.packet.count==0 >> Err(EmptyPacket)
  input.lanes.free==0 >> Err(NoLane)
  _ >> Ok(input)

# レイアウト戦略だけをRust側の手書き実装へ分離する。
~layout_lane(input:BatchInput):BatchLayout

>build_batch(input:BatchInput):BatchLayout|Error
  checked := input /> validate?
  layout := checked /> layout_lane
  limited := layout /> |x| BatchLayout(x.lane,min(x.size,10))
  Ok(limited)

!submit_batch(layout:BatchLayout):SubmitReceipt

# public entryは検証・layout・submitの三段だけを接続する。
>run(input:BatchInput):SubmitReceipt|Error
  batch := input /> build_batch?
  receipt := batch /> submit_batch
  Ok(receipt)
