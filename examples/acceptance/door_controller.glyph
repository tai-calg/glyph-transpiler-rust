system DoorController
  entry control
  source sensor
  sink lock
  sink alarm

machine Door(state:DoorState,input:Input)
  select=state.mode
  action=state.action
  init=DoorState(Locked,0,KeepLocked)
  next=step(state,input)
  success=Locked
  failure=Faulted

@LOCK_LIMIT=500ms

*Input(badge_valid,request_open,forced_open,unlocked,locked,alarmed:B)
+Action=KeepLocked|Unlock|RaiseAlarm
+Mode=Locked|Unlocked|Alarmed|Faulted
*DoorState(mode:Mode,failures:U,action:Action)

+EffectKind=LockConfirmed|AlarmConfirmed
*Receipt(effect:EffectKind,state:DoorState)

+ControlError=SensorFailure|LockFailure|AlarmFailure|EffectTimeout|InvalidReceipt

# 解錠が観測されたら500ms以内に施錠されなければならない。
?lock_deadline(*Input)=@A(unlocked>>@E LOCK_LIMIT locked)
# こじ開けが観測されたらalarm状態でなければならない。
?forced_open_safe(*Input)=@A(forced_open>>alarmed)

# Systemが必要な時に値を取得する外部source。
ext sensor():Input|ControlError

>authenticate(input:Input):B=input.badge_valid&!input.forced_open

>decide(input:Input):Action
  input.forced_open >> RaiseAlarm
  authenticate(input)&input.request_open >> Unlock
  _ >> KeepLocked

>step(state:DoorState,input:Input):DoorState
  action := decide(input)
  next :=
    action==RaiseAlarm >> DoorState(Alarmed,state.failures+1,RaiseAlarm)
    action==Unlock >> DoorState(Unlocked,state.failures,Unlock)
    action==KeepLocked >> DoorState(Locked,state.failures,KeepLocked)
    _ >> DoorState(Faulted,state.failures+1,KeepLocked)
  next

# Systemが外部作用を要求するsink。戻り値は完了確認または失敗を表す。
!lock(state:DoorState):Receipt|ControlError
!alarm(state:DoorState):Receipt|ControlError

>apply(state:DoorState):Receipt|ControlError
  state.action==RaiseAlarm >> alarm(state)
  _ >> lock(state)

# 外部からinvokeされるentry。引数と戻り型がSystemの完全な同期境界になる。
>control(state:DoorState):Receipt|ControlError
  input := sensor()?
  next := step(state,input)
  apply(next)
