system MotorSafety
  entry cycle

  in state:MotorState
  in input:Input
  out receipt:Receipt

  state -> cycle
  input -> cycle
  cycle -> receipt
  cycle -> write_motor

machine Motor(state:MotorState,input:Input)
  select=state.mode
  action=state.command
  init=MotorState(Stopped,DisableMotor)
  next=step(state,input)
  success=Stopped
  failure=Faulted

@STOP_LIMIT=100ms

*Input(raw:F,enabled,emergency,fault,stopped:B)
+MotorCommand=DisableMotor|SetMotorPower(F)
+Mode=Stopped|Running|Faulted
*MotorState(mode:Mode,command:MotorCommand)
*Receipt(command:MotorCommand)

?emergency_stop(*Input)=@A(emergency>>@E STOP_LIMIT stopped)
?fault_stop(*Input)=@A(fault>>@E STOP_LIMIT stopped)

>normalize(raw:F):F=min(raw,1.0)

>decide(input:Input):MotorCommand
  input.emergency|input.fault >> DisableMotor
  !input.enabled >> DisableMotor
  _ >> SetMotorPower(normalize(input.raw))

>step(state:MotorState,input:Input):MotorState
  command := decide(input)
  next :=
    command==DisableMotor >> MotorState(Stopped,DisableMotor)
    command==SetMotorPower(power) >> MotorState(Running,SetMotorPower(power))
    _ >> MotorState(Faulted,DisableMotor)
  next

!write_motor(command:MotorCommand):Receipt

# 一周期のentryは状態計算と外部作用の接続だけを担当する。
>cycle(state:MotorState,input:Input):Receipt=write_motor(step(state,input).command)
