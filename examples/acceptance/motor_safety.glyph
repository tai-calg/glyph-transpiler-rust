system MotorSafety
  entry cycle

  in state:MotorState
  in input:Input
  out receipt:Receipt

  state -> cycle
  input -> cycle
  cycle -> receipt
  cycle -> write_motor

machine Motor(state:MotorState,input:Input)
  select=state.mode
  # Legacy spelling: this projects an emitted command for decision provenance.
  # It is not the state-transition Action rendered on the edge.
  action=state.command
  init=MotorState(Stopped,DisableMotor,Receipt(DisableMotor))
  next=step(state,input)
  success=Stopped
  failure=Faulted

@STOP_LIMIT=100ms

*Input(raw:F,enabled,emergency,fault,stopped:B)
+MotorCommand=EmergencyBrake|DisableMotor|SetMotorPower(F)|LatchFault
+Mode=Stopped|Running|Faulted
*Receipt(command:MotorCommand)
*MotorState(mode:Mode,command:MotorCommand,receipt:Receipt)

?emergency_stop(*Input)=@A(emergency>>@E STOP_LIMIT stopped)
?fault_stop(*Input)=@A(fault>>@E STOP_LIMIT stopped)

>normalize(raw:F):F=min(raw,1.0)

>decide(input:Input):MotorCommand
  input.fault >> LatchFault
  input.emergency >> EmergencyBrake
  !input.enabled >> DisableMotor
  _ >> SetMotorPower(normalize(input.raw))

!write_motor(command:MotorCommand):Receipt

# 状態遷移は純粋に次状態を計算する。Receipt(command)は公開strict契約上、
# cycleで実行されるwrite_motor(command)の戻り値と同一である。
>step(state:MotorState,input:Input):MotorState
  command := decide(input)
  receipt := Receipt(command)
  next :=
    command==LatchFault >> MotorState(Faulted,LatchFault,receipt)
    command==EmergencyBrake >> MotorState(Stopped,EmergencyBrake,receipt)
    command==DisableMotor >> MotorState(Stopped,DisableMotor,receipt)
    command==SetMotorPower(power) >> MotorState(Running,SetMotorPower(power),receipt)
    _ >> MotorState(Faulted,LatchFault,Receipt(LatchFault))
  next

# 外向き作用はSystem entryで一度だけ実行し、その実結果を返す。
>cycle(state:MotorState,input:Input):Receipt
  next := step(state,input)
  receipt := write_motor(next.command)
  receipt
