{
  "name": "glyph-desktop",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev:web": "vite --config vite.config.js",
    "build:web": "vite build --config vite.config.js",
    "dev": "python3 scripts/build_sidecar.py --development && tauri dev",
    "build": "python3 scripts/build_sidecar.py && tauri build",
    "check": "python3 scripts/build_sidecar.py --placeholder && npm run build:web && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "vite": "^7.1.3"
  }
}
